# Copy to .env.local and fill in. Never commit real keys.
# Anything left blank falls back safely (see README → "What runs without credentials").

APP_URL=http://localhost:3000

# ── Console login (required: /console and /api/ops/* are always locked without it) ──
CONSOLE_USER=admin
CONSOLE_PASSWORD=               # 8+ characters

# ── Decart: live AI try-on (Lucy VTON) ─────────────────────────────────
# platform.decart.ai → API keys. Stays server-side; browsers get 60-second scoped tokens.
DECART_API_KEY=
DECART_MODEL=lucy-vton-latest
DECART_MAX_SESSION_SECONDS=300  # hard cap per try-on session (also enforced in the token)

# ── AgenticOrg: agents (recommend only) ────────────────────────────────
# Dashboard → Settings → API Keys. Key needs MCP scope (mcp:write).
AGENTICORG_API_KEY=
AGENTICORG_BASE_URL=https://agenticorg.hackathon.pinelabs.com
AGENTICORG_COMPANY_ID=          # optional on the hackathon host
AGENTICORG_MERCHANT_ID=merchant_demo
# MCP tool per unit. List the tools your key can call: GET /api/ops/tools (console login)
AGENTICORG_CONCIERGE_TOOL=agenticorg_chat_agent
AGENTICORG_STYLIST_TOOL=agenticorg_product_agent
AGENTICORG_ORDER_REVIEW_TOOL=agenticorg_risk_sentinel
AGENTICORG_REFUND_REVIEW_TOOL=agenticorg_complaint_resolution
AGENTICORG_RECON_TOOL=agenticorg_recon_agent
AGENTICORG_MIRROR_CASES=false   # also file each approval as an AgenticOrg governed case

# ── Pine Labs Online (Plural) ──────────────────────────────────────────
PINELABS_ENV=uat                # uat (sandbox) | prod
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=
PINELABS_SECRET_KEY=            # hex key for redirect-callback signatures (from onboarding)
PINELABS_WEBHOOK_SECRET=        # base64 webhook secret (dashboard → Settings → Webhooks)
ALLOW_LIVE_PAYMENTS=false       # must be true for PINELABS_ENV=prod to charge anyone
DEMO_PAYMENTS=                  # set true to allow simulated checkout in a production build

# ── Human-in-the-loop policy ───────────────────────────────────────────
ORDER_APPROVAL_MODE=always              # always | threshold
ORDER_REVIEW_THRESHOLD_PAISE=500000     # threshold mode: orders ≥ ₹5,000 always go to a human
REFUND_AUTO_APPROVE_LIMIT_PAISE=0       # 0 = every refund needs a human
MIN_AGENT_CONFIDENCE=0.8                # below this, a human decides

# ── Storage ────────────────────────────────────────────────────────────
DATA_DIR=                        # SQLite location (default ./.data)


# ── Free photo try-on (fallback for free users) ────────────────────────
# IDM-VTON on Hugging Face ZeroGPU. Works without a token; a free HF token
# (huggingface.co/settings/tokens, read scope) gives a bigger daily GPU quota.
FREE_TRYON_ENABLED=true
FREE_TRYON_SPACE=yisol/IDM-VTON
HF_TOKEN=
# Reserve paid Decart credits: shoppers must enter this code to use Live AI
DECART_ACCESS_CODE=

# ── Database ───────────────────────────────────────────────────────────
# Postgres (e.g. Supabase → Project settings → Database → Connection string, "Transaction pooler").
# Required on serverless hosts like Vercel. Leave empty to use local SQLite (DATA_DIR).
DATABASE_URL=
