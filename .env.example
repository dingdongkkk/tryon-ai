# Copy to .env.local and fill in. Any integration left blank runs in mock mode.
APP_URL=http://localhost:3000

# ── AgenticOrg (agents + human-in-the-loop) ─────────────────────────────
# Settings → API Keys in the AgenticOrg dashboard. Key needs MCP scope (mcp:write).
AGENTICORG_API_KEY=
AGENTICORG_BASE_URL=https://app.agenticorg.ai
AGENTICORG_COMPANY_ID=
AGENTICORG_MERCHANT_ID=merchant_demo
# MCP tool names. List yours at GET /api/agenticorg/tools
AGENTICORG_STYLIST_TOOL=agenticorg_commerce_sales_agent
AGENTICORG_ORDER_REVIEW_TOOL=agenticorg_commerce_sales_agent
AGENTICORG_REFUND_REVIEW_TOOL=agenticorg_ar_collections
# Also file each approval as an AgenticOrg governed case (audit trail)
AGENTICORG_MIRROR_CASES=false

# ── Pine Labs Online (Plural) ──────────────────────────────────────────
PINELABS_ENV=uat            # uat | prod
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=
PINELABS_SECRET_KEY=        # hex secret used to verify callback signatures

# ── 3dcart / Shift4Shop ────────────────────────────────────────────────
SHIFT4SHOP_API_URL=https://apirest.3dcart.com/3dCartWebAPI/v1
SHIFT4SHOP_SECURE_URL=      # e.g. yourstore.3dcartstores.com
SHIFT4SHOP_PRIVATE_KEY=     # your app's private key (dev portal)
SHIFT4SHOP_TOKEN=           # merchant token issued when the store installs your app

# ── Human-in-the-loop policy ───────────────────────────────────────────
ORDER_APPROVAL_MODE=always              # always | threshold
ORDER_REVIEW_THRESHOLD_PAISE=500000     # ₹5,000
REFUND_AUTO_APPROVE_LIMIT_PAISE=0       # 0 = every refund needs a human
MIN_AGENT_CONFIDENCE=0.8

# ── Console login (basic auth on /console) ─────────────────────────────
CONSOLE_USER=admin
CONSOLE_PASSWORD=
